---
import Layout from "../../layouts/default.astro";
---

<Layout>
	<a href="/awesome" class="w-full text-center underline">back to main list</a>
	<div class="text-3xl w-full text-center p-4">Cool Graphical Stuff</div>
	<div class="flex flex-wrap w-full items-center gap-8 p-4 justify-center">
		<div class="border-2 border-fg flex-col items-center text-center gap-4 p-4 max-w-md">
			<a href="https://glyphtrix.art/" class="text-2xl p-4">
				Glyphatrix
			</a>
			<div class="text-md">Really cool ascii art generator thing, runs locally in a browser</div>
		</div>
		<div class="border-2 border-fg flex-col items-center text-center gap-4 p-4 max-w-md">
			<a href="https://github.com/manoelpiovesan/dither-guy" class="text-2xl p-4">
				Dither Guy
			</a>
			<div class="text-md">A tool I've allegedly used for cover art</div>
		</div>
		<div class="border-2 border-fg flex-col items-center text-center gap-4 p-4 max-w-md">
			<a href="https://github.com/x-hw/amazing-qr" class="text-2xl p-4">
				amazing-qr
			</a>
			<div class="text-md">A neat stylized qr code generator I dig, minus the AI bullshit.</div>
		</div>
	</div>
</Layout>
