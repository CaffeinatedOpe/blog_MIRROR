---
import Layout from "../../layouts/default.astro";
---

<Layout>
	<a href="/awesome" class="w-full text-center underline">
		back to main list
	</a>
	<div class="text-3xl w-full text-center p-4">Cool Repos</div>
	<div class="flex flex-wrap w-full items-center gap-8 p-4 justify-center">
		<div class="border-2 border-fg flex-col items-center text-center gap-4 p-4 max-w-md">
			<a href="https://catppuccin.com/" class="text-2xl p-4">
				Catppuccin
			</a>
			<div class="text-md">Beautiful color scheme, I use it on everything.</div>
		</div>
		<div class="border-2 border-fg flex-col items-center text-center gap-4 p-4 max-w-md">
			<a href="https://github.com/ktwrd/88x31" class="text-2xl p-4">
				ktwrd's 88x31 repo
			</a>
			<div class="text-md">got a few images from here that are now in my personal 8831 repo</div>
		</div>
		<div class="border-2 border-fg flex-col items-center text-center gap-4 p-4 max-w-md">
			<a href="https://github.com/rochacbruno/rust_memes" class="text-2xl p-4">
				Rust Memes by rochacbruno
			</a>
			<div class="text-md">funni</div>
		</div>
		<div class="border-2 border-fg flex-col items-center text-center gap-4 p-4 max-w-md">
			<a href="https://github.com/cat-milk/Anime-Girls-Holding-Programming-Books" class="text-2xl p-4">
				Anime Girls Holding Programming Books
			</a>
			<div class="text-md">yeag.</div>
		</div>
	</div>
</Layout>
