---
import Layout from "../../layouts/default.astro";
---

<Layout>
	<a href="/awesome" class="w-full text-center underline">back to main list</a>
	<div class="text-3xl w-full text-center p-4">Cool Audio Stuff</div>
	<div class="flex flex-wrap w-full items-center gap-8 p-4 justify-center">
		<div class="border-2 border-fg flex-col items-center text-center gap-4 p-4 max-w-md">
			<a href="https://github.com/jmshrv/finamp" class="text-2xl p-4">
				Finamp
			</a>
			<div class="text-md">Best app I've found for streaming media from Jellyfin, with downloads.</div>
		</div>
		<div class="border-2 border-fg flex-col items-center text-center gap-4 p-4 max-w-md">
			<a href="https://www.decentsamples.com/" class="text-2xl p-4">
				Decent Samples
			</a>
			<div class="text-md">A mix of paid and free audio plugins, with an open source engine, and works on linux!</div>
		</div>
	</div>
</Layout>
