---
import Layout from "../../layouts/default.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const projects = (await getCollection("projects")).sort(
	(a, b) => b.data.sort.valueOf() - a.data.sort.valueOf(),
);
---

<title>Projects</title>

<Layout>
	<div class="p-4 flex items-center justify-center">
		<h1 class="text-4xl p-4 rounded-2xl">Blogs</h1>
	</div>
	<div
		class="flex flex-col items-center justify-center text-lg gap-4"
	>
		{
			projects.map((project) => (
				<a
					href={`/projects/${project.id}`}
					class="p-4 border flex flex-row"
				>
					<div class="">
						<Image
							src={project.data.thumbnail_dark}
							class="h-32 w-auto aspect-auto object-cover"
							alt="blogpost image"
						/>
					</div>
					<div class="flex flex-col flex-wrap items-center justify-center text-l p-4 flex-3">
						<div class="text-center text-2xl">{project.data.title}</div>
						<div class="text-center">{project.data.description}</div>
					</div>
				</a>
			))
		}
	</div>
</Layout>