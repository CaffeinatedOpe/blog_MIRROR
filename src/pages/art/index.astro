---
import Layout from "../../layouts/default.astro";
import { Image } from "astro:assets";
import pfp from "../assets/pfp.png";

function shuffle(array: string[]) {
	let currentIndex = array.length;

	// While there remain elements to shuffle...
	while (currentIndex != 0) {
		// Pick a remaining element...
		let randomIndex = Math.floor(Math.random() * currentIndex);
		currentIndex--;

		// And swap it with the current element.
		[array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
	}
}
---

<Layout>
	<div class="flex flex-col flex-wrap w-full items-center gap-8 p-8">
		<div class="text-3xl border-2 border-fg p-4">Artsy Stuff</div>
		<div class="text-lg text-center">Not a ton here. Will there be more? Probably, i dunno. Not everything here was made by hand, but it's all my own original work. No generative AI.</div>
